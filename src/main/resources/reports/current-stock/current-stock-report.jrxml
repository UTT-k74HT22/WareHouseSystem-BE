<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE jasperReport PUBLIC "//JasperReports//DTD Report Design//EN"
        "http://jasperreports.sourceforge.net/dtds/jasperreport.dtd">
<jasperReport name="current_stock_report"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="802"
              leftMargin="20"
              rightMargin="20"
              topMargin="20"
              bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

    <!-- ═══════════════════════════════════════════
         1. STYLES  (must come before parameters/fields per DTD)
         ═══════════════════════════════════════════ -->
    <style name="Base"   fontName="DejaVu Sans" fontSize="10"/>
    <style name="Title"  fontName="DejaVu Sans" fontSize="18" isBold="true"/>
    <style name="Meta"   fontName="DejaVu Sans" fontSize="9"/>
    <style name="Header" fontName="DejaVu Sans" fontSize="10" isBold="true"/>
    <style name="Cell"   fontName="DejaVu Sans" fontSize="9"/>
    <style name="Footer" fontName="DejaVu Sans" fontSize="9"  isItalic="true"/>

    <!-- ═══════════════════════════════════════════
         2. PARAMETERS
         ═══════════════════════════════════════════ -->
    <parameter name="reportTitle"  class="java.lang.String"/>
    <parameter name="generatedAt"  class="java.lang.String"/>
    <parameter name="generatedBy"  class="java.lang.String"/>
    <parameter name="totalRows"    class="java.lang.Integer"/>

    <!-- ═══════════════════════════════════════════
         3. FIELDS
         ═══════════════════════════════════════════ -->
    <field name="sku"               class="java.lang.String"/>
    <field name="productName"       class="java.lang.String"/>
    <field name="warehouseName"     class="java.lang.String"/>
    <field name="locationCode"      class="java.lang.String"/>
    <field name="batchNumber"       class="java.lang.String"/>
    <field name="onHandQuantity"    class="java.math.BigDecimal"/>
    <field name="reservedQuantity"  class="java.math.BigDecimal"/>
    <field name="availableQuantity" class="java.math.BigDecimal"/>

    <!-- ═══════════════════════════════════════════
         4. TITLE BAND
         ═══════════════════════════════════════════ -->
    <title>
        <band height="72">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="72"/>
            </rectangle>

            <!-- Company name -->
            <staticText>
                <reportElement style="Header" x="12" y="8" width="240" height="18"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Ware House System]]></text>
            </staticText>

            <!-- Report title -->
            <textField>
                <reportElement style="Title" x="12" y="28" width="380" height="26"/>
                <textElement>
                    <font fontName="DejaVu Sans" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{reportTitle} == null ? "Current Stock Report" : $P{reportTitle}]]></textFieldExpression>
            </textField>

            <!-- Meta: Generated at -->
            <textField>
                <reportElement style="Meta" x="520" y="8" width="270" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated at: " + ($P{generatedAt} == null ? "-" : $P{generatedAt})]]></textFieldExpression>
            </textField>

            <!-- Meta: Generated by -->
            <textField>
                <reportElement style="Meta" x="520" y="24" width="270" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generated by: " + ($P{generatedBy} == null ? "-" : $P{generatedBy})]]></textFieldExpression>
            </textField>

            <!-- Meta: Total rows -->
            <textField>
                <reportElement style="Meta" x="520" y="40" width="270" height="14"/>
                <textElement textAlignment="Right">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Total rows: " + String.valueOf($P{totalRows} == null ? 0 : $P{totalRows})]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="12" y="62" width="778" height="1"/>
            </line>
        </band>
    </title>

    <!-- ═══════════════════════════════════════════
         5. COLUMN HEADER BAND
         ═══════════════════════════════════════════ -->
    <columnHeader>
        <band height="24">
            <rectangle>
                <reportElement x="0" y="0" width="802" height="24"/>
            </rectangle>

            <staticText>
                <reportElement style="Header" x="0" y="4" width="90" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[SKU]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="90" y="4" width="220" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Product Name]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="310" y="4" width="130" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Warehouse]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="440" y="4" width="80" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Location]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="520" y="4" width="90" height="16"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Batch]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="610" y="4" width="64" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[On Hand]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="674" y="4" width="64" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Reserved]]></text>
            </staticText>

            <staticText>
                <reportElement style="Header" x="738" y="4" width="64" height="16"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Available]]></text>
            </staticText>
        </band>
    </columnHeader>

    <!-- ═══════════════════════════════════════════
         6. DETAIL BAND
         ═══════════════════════════════════════════ -->
    <detail>
        <band height="22">
            <textField isBlankWhenNull="true">
                <reportElement style="Cell" x="0" y="2" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{sku} == null ? "-" : $F{sku}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Cell" x="90" y="2" width="220" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{productName} == null ? "-" : $F{productName}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Cell" x="310" y="2" width="130" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{warehouseName} == null ? "-" : $F{warehouseName}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Cell" x="440" y="2" width="80" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{locationCode} == null ? "-" : $F{locationCode}]]></textFieldExpression>
            </textField>

            <textField isBlankWhenNull="true">
                <reportElement style="Cell" x="520" y="2" width="90" height="18"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{batchNumber} == null ? "-" : $F{batchNumber}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.##">
                <reportElement style="Cell" x="610" y="2" width="64" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{onHandQuantity} == null ? java.math.BigDecimal.ZERO : $F{onHandQuantity}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.##">
                <reportElement style="Cell" x="674" y="2" width="64" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{reservedQuantity} == null ? java.math.BigDecimal.ZERO : $F{reservedQuantity}]]></textFieldExpression>
            </textField>

            <textField pattern="#,##0.##">
                <reportElement style="Cell" x="738" y="2" width="64" height="18"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{availableQuantity} == null ? java.math.BigDecimal.ZERO : $F{availableQuantity}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <!-- ═══════════════════════════════════════════
         7. PAGE FOOTER BAND
         ═══════════════════════════════════════════ -->
    <pageFooter>
        <band height="24">
            <line>
                <reportElement x="0" y="0" width="802" height="1"/>
            </line>

            <staticText>
                <reportElement style="Footer" x="0" y="6" width="220" height="14"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[Ware House System]]></text>
            </staticText>

            <textField>
                <reportElement style="Footer" x="622" y="6" width="180" height="14"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="9" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <!-- ═══════════════════════════════════════════
         8. NO DATA BAND
         ═══════════════════════════════════════════ -->
    <noData>
        <band height="60">
            <staticText>
                <reportElement x="0" y="20" width="802" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="DejaVu Sans" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[No inventory data matched the selected filters.]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
