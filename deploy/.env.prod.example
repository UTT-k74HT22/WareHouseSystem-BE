# Container image
APP_IMAGE=ghcr.io/your-org/whs-backend:prod

# Domain and TLS
DOMAIN_NAME=whs.example.com
TLS_CERT_PATH=/etc/nginx/certs/fullchain.pem
TLS_KEY_PATH=/etc/nginx/certs/privkey.pem

# Spring Boot
SPRING_PROFILES_ACTIVE=prod
SPRING_APPLICATION_NAME=whs-backend
SERVER_PORT=8080

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=whs_db
MYSQL_USER=whs_user
MYSQL_PASSWORD=change_me_app_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=whs
RABBITMQ_DEFAULT_PASS=change_me_rabbit_password

# MinIO Configuration
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_BUCKET_NAME=whs-storage

# Security Configuration
JWT_SECRET=replace_with_a_long_random_base64_secret
CORS_ALLOWED_ORIGINS=https://app.example.com

# Mail Configuration
EMAIL_ENABLED=true
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Warehouse Management System
EMAIL_ATTACHMENT_PATH=/app/temp/email-attachments
EMAIL_QUEUE_NAME=wms.email.queue
EMAIL_EXCHANGE_NAME=wms.email.exchange
EMAIL_ROUTING_KEY=wms.email.send
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=change_me_mail_password


# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password
GRAFANA_ROOT_URL=https://monitoring.example.com/grafana
MYSQL_EXPORTER_USER=monitor
MYSQL_EXPORTER_PASSWORD=change_me_mysql_exporter_password

