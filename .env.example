# Docker Compose Environment Variables
# Copy this file to .env and update values as needed

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=whs_db
MYSQL_USER=whs_user
MYSQL_PASSWORD=whs_password
MYSQL_PORT=3306

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# ==========================================
# RABBITMQ CONFIGURATION
# ==========================================
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================
SPRING_APPLICATION_NAME=whs-backend
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ==========================================
# JWT CONFIGURATION
# ==========================================
# IMPORTANT: Change this to a strong random value in production
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_for_HS256_algorithm

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@warehouse.com
EMAIL_FROM_NAME=Warehouse Management System
EMAIL_ATTACHMENT_PATH=temp/email-attachments

# ==========================================
# CORS CONFIGURATION
# ==========================================
# Development - localhost with common frontend ports
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Production - IMPORTANT: Replace with your actual frontend domain(s)
# Example: CORS_ALLOWED_ORIGINS=https://warehouse.yourdomain.com,https://www.warehouse.yourdomain.com

CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# ==========================================
# SPRING BOOT CONFIGURATION (for docker-compose)
# ==========================================
spring:
  # DataSource Configuration - Development
  datasource:
    url: jdbc:mysql://localhost:3306/whs_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: whs_user
    password: whs_password

  # Redis Configuration - Development
  data:
    redis:
      host: localhost
      port: 6379
      password: redis123

  # RabbitMQ Configuration - Development
  rabbitmq:
    host: localhost
    port: 5672
    username: admin
    password: admin123

  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    root: INFO
    org.demo.whs: DEBUG
    org.springframework.web: DEBUG
    org.springframework.security: DEBUG

