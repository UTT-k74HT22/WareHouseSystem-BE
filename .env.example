# Docker Compose Environment Variables
# Copy this file to .env and update values as needed

# Database Configuration
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=whs_db
MYSQL_USER=whs_user
MYSQL_PASSWORD=whs_password
MYSQL_PORT=3306

# Redis Configuration
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# RabbitMQ Configuration
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin123

# Application Configuration
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
spring:
  # DataSource Configuration - Development
  datasource:
    url: jdbc:mysql://localhost:3306/whs_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
    username: whs_user
    password: whs_password

  # Redis Configuration - Development
  data:
    redis:
      host: localhost
      port: 6379
      password: redis123

  # RabbitMQ Configuration - Development
  rabbitmq:
    host: localhost
    port: 5672
    username: admin
    password: admin123

  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true

logging:
  level:
    root: INFO
    org.demo.whs: DEBUG
    org.springframework.web: DEBUG
    org.springframework.security: DEBUG

