{
  "info": {
    "name": "WHS Product API",
    "description": "API Test Collection for Product Module - CRUD Operations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "any"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "productSku",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "CAT001"
    },
    {
      "key": "uomId",
      "value": "UOM001"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}"
      }
    ]
  },
  "item": [
    {
      "name": "00-Setup",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 200 on login\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should save auth token\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    console.log(\"Response data:\", JSON.stringify(jsonData.data));",
                  "    if (jsonData.data && jsonData.data.access_token) {",
                  "        pm.environment.set(\"authToken\", jsonData.data.access_token);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01-Create",
      "item": [
        {
          "name": "Create Product - Success",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Product API 001\",\n  \"description\": \"Product for API testing\",\n  \"category_id\": \"{{categoryId}}\",\n  \"uom_id\": \"{{uomId}}\",\n  \"weight\": 1.5,\n  \"dimensions\": \"10x20x30\",\n  \"min_stock_level\": 10,\n  \"max_stock_level\": 1000,\n  \"reorder_point\": 50,\n  \"cost_price\": 100.00,\n  \"selling_price\": 150.00,\n  \"barcode\": \"TESTAPI123456\",\n  \"requires_batch_tracking\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 201 when product is created\", function() {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Should return success status\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equals(true);",
                  "});",
                  "",
                  "pm.test(\"Should return success message\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.equals(\"Product created successfully\");",
                  "});",
                  "",
                  "pm.test(\"Should generate product ID\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.be.ok;",
                  "});",
                  "",
                  "pm.test(\"Should auto-generate SKU\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.sku).to.be.ok;",
                  "});",
                  "",
                  "pm.test(\"Should save product ID for other tests\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"productId\", jsonData.data.id);",
                  "    pm.environment.set(\"productSku\", jsonData.data.sku);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Product - Validation Error - Missing Name",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Product without name\",\n  \"category_id\": \"{{categoryId}}\",\n  \"uom_id\": \"{{uomId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 400 when name is missing\", function() {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02-Read",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products"],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 200 OK\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should return success status\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equals(true);",
                  "});",
                  "",
                  "pm.test(\"Should return paginated data\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.content).to.be.an(\"array\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 200 when product is found\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should return correct product ID\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.id).to.equals(pm.environment.get(\"productId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product By SKU",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/sku/{{productSku}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "sku", "{{productSku}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 200 when SKU is found\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should return correct SKU\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.sku).to.equals(pm.environment.get(\"productSku\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product - Not Found",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/NOT_EXIST",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "NOT_EXIST"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 404 when product not found\", function() {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03-Update",
      "item": [
        {
          "name": "Update Product - Success",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Test Product\",\n  \"description\": \"Updated description\",\n  \"category_id\": \"{{categoryId}}\",\n  \"uom_id\": \"{{uomId}}\",\n  \"weight\": 2.0,\n  \"dimensions\": \"15x25x35\",\n  \"min_stock_level\": 20,\n  \"max_stock_level\": 2000,\n  \"reorder_point\": 100,\n  \"cost_price\": 120.00,\n  \"selling_price\": 180.00,\n  \"barcode\": \"TESTAPI123456UP\",\n  \"requires_batch_tracking\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 200 OK\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should return success status\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equals(true);",
                  "});",
                  "",
                  "pm.test(\"Should return success message\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.equals(\"Product updated successfully\");",
                  "});",
                  "",
                  "pm.test(\"Should return updated name\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.name).to.equals(\"Updated Test Product\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Product - Not Found",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/NOT_EXIST",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "NOT_EXIST"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Product\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 404 when product not found\", function() {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04-Delete",
      "item": [
        {
          "name": "Delete Product - Success",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 200 OK\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should return success status\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.equals(true);",
                  "});",
                  "",
                  "pm.test(\"Should return success message\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.message).to.equals(\"Product deleted successfully\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Product - Not Found",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/NOT_EXIST",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "NOT_EXIST"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 404 when product not found\", function() {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05-Verification",
      "item": [
        {
          "name": "Get Deleted Product - Verify",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "products", "{{productId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should return 404 after deletion\", function() {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
