{
  "info": {
    "name": "WHS Inventory Race Condition Tests",
    "description": "API Test Collection for Race Condition Testing in Inventory Module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "testProductId",
      "value": "PROD_RC_TEST"
    },
    {
      "key": "testWarehouseId",
      "value": "WHS001"
    },
    {
      "key": "testLocationId",
      "value": "LOC001"
    },
    {
      "key": "initialInventoryId",
      "value": ""
    },
    {
      "key": "onHandQty",
      "value": "0"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}"
      }
    ]
  },
  "item": [
    {
      "name": "00-Setup",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should login successfully\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should save auth token\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    console.log(\"Response data:\", JSON.stringify(jsonData.data));",
                  "    if (jsonData.data && jsonData.data.access_token) {",
                  "        pm.environment.set(\"authToken\", jsonData.data.access_token);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Initial Inventory",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventories/increase",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventories", "increase"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{testProductId}}\",\n  \"warehouseId\": \"{{testWarehouseId}}\",\n  \"locationId\": \"{{testLocationId}}\",\n  \"batchId\": null,\n  \"quantity\": 100,\n  \"referenceType\": \"STOCK_ADJUSTMENT\",\n  \"referenceId\": \"RC-SETUP-{{$timestamp}}\",\n  \"referenceNumber\": \"RC-SETUP-{{$timestamp}}\",\n  \"reason\": \"Setup initial inventory for race condition test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should create initial inventory\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should save inventory ID\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.collectionVariables.set(\"initialInventoryId\", jsonData.data.id);",
                  "        pm.collectionVariables.set(\"onHandQty\", 100);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current Inventory",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventories?productId={{testProductId}}&warehouseId={{testWarehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventories"],
              "query": [
                {
                  "key": "productId",
                  "value": "{{testProductId}}"
                },
                {
                  "key": "warehouseId",
                  "value": "{{testWarehouseId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should get inventory\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should log current onHand quantity\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.content && jsonData.data.content.length > 0) {",
                  "        var inventory = jsonData.data.content[0];",
                  "        console.log(\"Current onHand:\", inventory.onHandQuantity);",
                  "        console.log(\"Reserved:\", inventory.reservedQuantity);",
                  "        console.log(\"Available:\", inventory.availableQuantity);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
