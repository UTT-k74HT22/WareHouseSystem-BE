                  "pm.test(\"Should setup inventory\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "First Request Holds Lock",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventories/decrease",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventories", "decrease"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{testProductId}}\",\n  \"warehouseId\": \"{{testWarehouseId}}\",\n  \"locationId\": \"{{testLocationId}}\",\n  \"batchId\": null,\n  \"quantity\": 10,\n  \"consumeReserved\": false,\n  \"referenceType\": \"STOCK_ADJUSTMENT\",\n  \"referenceId\": \"RC-LOCK-1\",\n  \"referenceNumber\": \"RC-LOCK-1\",\n  \"reason\": \"First request to hold lock\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"First request should succeed\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Concurrent Request - Same Reference",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventories/decrease",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventories", "decrease"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{testProductId}}\",\n  \"warehouseId\": \"{{testWarehouseId}}\",\n  \"locationId\": \"{{testLocationId}}\",\n  \"batchId\": null,\n  \"quantity\": 10,\n  \"consumeReserved\": false,\n  \"referenceType\": \"STOCK_ADJUSTMENT\",\n  \"referenceId\": \"RC-LOCK-1\",\n  \"referenceNumber\": \"RC-LOCK-1\",\n  \"reason\": \"Concurrent request with same reference\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Concurrent request with same reference should be handled\", function() {",
                  "    // With lock, this should either:",
