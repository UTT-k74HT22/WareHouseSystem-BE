          ]
        },
        {
          "name": "Verify Total After Concurrent Increase",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventories?productId={{testProductId}}&warehouseId={{testWarehouseId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventories"],
              "query": [
                {
                  "key": "productId",
                  "value": "{{testProductId}}"
                },
                {
                  "key": "warehouseId",
                  "value": "{{testWarehouseId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Should get inventory\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Should have correct total after concurrent increase\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    var inventory = jsonData.data.content[0];",
                  "    var expectedOnHand = 200; // 100 initial + 50 + 30 + 20",
                  "    ",
                  "    console.log(\"Expected onHand:\", expectedOnHand);",
                  "    console.log(\"Actual onHand:\", inventory.onHandQuantity);",
                  "    ",
                  "    pm.expect(parseFloat(inventory.onHandQuantity)).to.equals(expectedOnHand);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
