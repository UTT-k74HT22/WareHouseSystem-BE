    {
      "name": "04-Lock-Contention",
      "item": [
        {
          "name": "Setup - Reset Inventory",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/inventories/increase",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "inventories", "increase"]
