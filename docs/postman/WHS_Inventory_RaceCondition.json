            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{testProductId}}\",\n  \"warehouseId\": \"{{testWarehouseId}}\",\n  \"locationId\": \"{{testLocationId}}\",\n  \"batchId\": null,\n  \"quantity\": 100,\n  \"referenceType\": \"STOCK_ADJUSTMENT\",\n  \"referenceId\": \"RC-LOCK-SETUP-{{$timestamp}}\",\n  \"referenceNumber\": \"RC-LOCK-SETUP-{{$timestamp}}\",\n  \"reason\": \"Setup for lock contention test\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
