          "name": "[Admin] GET /inventories → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin can read inventories (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Response has data', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('data');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/inventories?page=0&size=5",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventories"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "[Admin] GET /sales-orders → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Admin can read sales orders (200)', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": {
              "raw": "{{base_url}}/api/v1/sales-orders?page=0&size=5",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "sales-orders"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "[Admin] Check Permission - Inventory Read",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Admin has INVENTORY READ permission', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.allowed).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"resource\": \"INVENTORY\",\n    \"action\": \"READ\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/check-permission",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "check-permission"]
            }
          }
        }
      ]
    },
    {
      "name": "05 - Input Validation Tests (→ 400)",
      "description": "Test server-side validation của request body",
      "item": [
        {
          "name": "Reserve with missing product_id → 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Missing required field → 400', () => pm.response.to.have.status(400));",
                  "pm.test('Not 500 (no NPE)', () => pm.response.to.not.have.status(500));",
                  "pm.test('Error message present', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('message');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"warehouse_id\": \"{{test_warehouse_id}}\",\n    \"quantity\": 1,\n    \"order_line_id\": \"some-line-id\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/inventories/reserve",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "inventories", "reserve"]
