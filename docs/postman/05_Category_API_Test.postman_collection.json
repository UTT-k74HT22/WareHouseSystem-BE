{
  "info": {
    "name": "WHS Category API Test",
    "description": "Postman test collection for Category module. Covers happy path, validation, filtering, update, and status transition cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "92000000-0000-0000-0000-000000000001"
    },
    {
      "key": "createdCategoryId",
      "value": ""
    },
    {
      "key": "missingCategoryId",
      "value": "99999999-9999-4999-8999-999999999999"
    }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "CAT-TC-01 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Save access token', function () {",
                  "  const json = pm.response.json();",
                  "  const token = json.data && (json.data.access_token || json.data.accessToken);",
                  "  pm.expect(token, 'access token').to.be.a('string').and.not.empty;",
                  "  pm.environment.set('authToken', token);",
                  "  pm.collectionVariables.set('authToken', token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Create Category",
      "item": [
        {
          "name": "CAT-TC-02 Create Category - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create category returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response wrapper is success', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.code).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.status).to.eql('ACTIVE');",
                  "  pm.environment.set('createdCategoryId', json.data.id);",
                  "  pm.collectionVariables.set('createdCategoryId', json.data.id);",
                  "  pm.environment.set('categoryId', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API Category {{$guid}}\",\n  \"description\": \"Category created by Postman automated test\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            }
          }
        },
        {
          "name": "CAT-TC-03 Create Category - Reject Client Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client-provided code is rejected', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Response wrapper is error', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CAT-MANUAL\",\n  \"name\": \"Manual Code Category {{$timestamp}}\",\n  \"description\": \"Should fail because category code is system generated\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            }
          }
        },
        {
          "name": "CAT-TC-04 Create Category - Missing Name",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing name returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Missing name\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            }
          }
        },
        {
          "name": "CAT-TC-05 Create Category - Missing Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing status returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"No Status Category {{$timestamp}}\",\n  \"description\": \"Missing status\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Read Category",
      "item": [
        {
          "name": "CAT-TC-06 List Categories - ACTIVE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List categories returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Page response has content array', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?status=ACTIVE&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "CAT-TC-07 List Categories - Invalid Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid enum value returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?status=DELETED",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "DELETED"
                }
              ]
            }
          }
        },
        {
          "name": "CAT-TC-08 Get Category By ID - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Get category returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Category id matches', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.id).to.eql(pm.environment.get('createdCategoryId') || pm.collectionVariables.get('createdCategoryId') || pm.environment.get('categoryId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{createdCategoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{createdCategoryId}}"
              ]
            }
          }
        },
        {
          "name": "CAT-TC-09 Get Category - Invalid ID Format",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Invalid id format returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/NOT-A-UUID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "NOT-A-UUID"
              ]
            }
          }
        },
        {
          "name": "CAT-TC-10 Get Category - Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing category returns 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{missingCategoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{missingCategoryId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Update Category",
      "item": [
        {
          "name": "CAT-TC-11 Update Category - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update category returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Name is updated', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.name).to.include('Updated');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API Category Updated {{$guid}}\",\n  \"description\": \"Updated by Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{createdCategoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{createdCategoryId}}"
              ]
            }
          }
        },
        {
          "name": "CAT-TC-12 Update Category - Reject Client Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client-provided code on update returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CAT-NEW\",\n  \"name\": \"Should Not Update Code\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{createdCategoryId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{createdCategoryId}}"
              ]
            }
          }
        },
        {
          "name": "CAT-TC-13 Update Category Status - INACTIVE",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Update category status returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Status is INACTIVE', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.status).to.eql('INACTIVE');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{createdCategoryId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "categories",
                "{{createdCategoryId}}",
                "status"
              ]
            }
          }
        },
        {
          "name": "CAT-TC-14 Update Category Status - Missing Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Missing status returns 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
