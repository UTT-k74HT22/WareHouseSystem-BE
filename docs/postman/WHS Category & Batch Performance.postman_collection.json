  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "PERF-SETUP Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Save access token aliases', function () {",
                  "  const json = pm.response.json();",
                  "  const token = json.data && (json.data.access_token || json.data.accessToken);",
                  "  pm.expect(token, 'access token').to.be.a('string').and.not.empty;",
                  "  pm.environment.set('authToken', token);",
                  "  pm.environment.set('access_token', token);",
                  "  pm.collectionVariables.set('authToken', token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_username}}\",\n  \"password\": \"{{admin_password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
