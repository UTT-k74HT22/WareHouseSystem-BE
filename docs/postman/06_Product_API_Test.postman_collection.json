{
  "info": {
    "name": "WHS Product API Test",
    "description": "Postman test collection for Product module. Covers create, validation, pagination, search, read, update, and soft delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "92000000-0000-0000-0000-000000000001"
    },
    {
      "key": "uomId",
      "value": "91000000-0000-0000-0000-000000000001"
    },
    {
      "key": "createdProductId",
      "value": ""
    },
    {
      "key": "createdProductSku",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "PRD-TC-01 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Save access token', function () {",
                  "  const json = pm.response.json();",
                  "  const token = json.data && (json.data.access_token || json.data.accessToken);",
                  "  pm.expect(token, 'access token').to.be.a('string').and.not.empty;",
                  "  pm.environment.set('authToken', token);",
                  "  pm.collectionVariables.set('authToken', token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Create Product",
      "item": [
        {
          "name": "PRD-TC-02 Create Product - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create product returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Product is created with generated SKU', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.sku).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.requires_batch_tracking).to.eql(true);",
                  "  pm.environment.set('createdProductId', json.data.id);",
                  "  pm.environment.set('createdProductSku', json.data.sku);",
                  "  pm.environment.set('productId', json.data.id);",
                  "  pm.environment.set('productSku', json.data.sku);",
                  "  pm.collectionVariables.set('createdProductId', json.data.id);",
                  "  pm.collectionVariables.set('createdProductSku', json.data.sku);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"API Product {{$timestamp}}\",\n  \"description\": \"Product created by Postman automated test\",\n  \"category_id\": \"{{categoryId}}\",\n  \"uom_id\": \"{{uomId}}\",\n  \"weight\": 1.250,\n  \"dimensions\": \"10x20x30\",\n  \"min_stock_level\": 10,\n  \"max_stock_level\": 100,\n  \"reorder_point\": 20,\n  \"cost_price\": 100.00,\n  \"selling_price\": 150.00,\n  \"barcode\": \"PM{{$timestamp}}\",\n  \"image_url\": \"products/postman-test.png\",\n  \"requires_batch_tracking\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            }
          }
        },
