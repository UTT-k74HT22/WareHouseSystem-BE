  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "BAT-TC-01 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Save access token', function () {",
                  "  const json = pm.response.json();",
                  "  const token = json.data && (json.data.access_token || json.data.accessToken);",
                  "  pm.expect(token, 'access token').to.be.a('string').and.not.empty;",
                  "  pm.environment.set('authToken', token);",
                  "  pm.collectionVariables.set('authToken', token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "BAT-SETUP Create Batch-Tracked Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Setup product returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Save setup product id', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.requires_batch_tracking).to.eql(true);",
                  "  pm.environment.set('batchProductId', json.data.id);",
                  "  pm.collectionVariables.set('batchProductId', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Batch Setup Product {{$guid}}\",\n  \"description\": \"Product dependency for batch API tests\",\n  \"category_id\": \"{{categoryId}}\",\n  \"uom_id\": \"{{uomId}}\",\n  \"min_stock_level\": 1,\n  \"max_stock_level\": 100,\n  \"reorder_point\": 10,\n  \"cost_price\": 10,\n  \"selling_price\": 15,\n  \"requires_batch_tracking\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            }
          }
        }
      ]
    },
