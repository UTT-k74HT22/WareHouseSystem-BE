      "name": "01 - Create Batch",
      "item": [
        {
          "name": "BAT-TC-02 Create Batch - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create batch returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Batch is AVAILABLE and generated number exists', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data.id).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.batch_number).to.be.a('string').and.not.empty;",
                  "  pm.expect(json.data.status).to.eql('AVAILABLE');",
                  "  pm.environment.set('createdBatchId', json.data.id);",
                  "  pm.environment.set('batchId', json.data.id);",
                  "  pm.collectionVariables.set('createdBatchId', json.data.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": \"{{batchProductId}}\",\n  \"manufacturing_date\": \"2026-04-01\",\n  \"expiry_date\": \"2027-04-01\",\n  \"supplier_batch_number\": \"SUP-PM-{{$timestamp}}\",\n  \"notes\": \"Batch created by Postman automated test\"\n}"
