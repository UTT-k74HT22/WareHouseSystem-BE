{
  "info": {
    "name": "WHS Batch API Test",
    "description": "Postman test collection for Batch module. Covers create, validation, filters, detail, update, blocked generic status patch, quarantine/release workflows, traceability, expiring and FIFO queries.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "categoryId",
      "value": "92000000-0000-0000-0000-000000000001"
    },
    {
      "key": "uomId",
      "value": "91000000-0000-0000-0000-000000000001"
    },
    {
      "key": "seedProductId",
      "value": "95000000-0000-0000-0000-000000000001"
    },
    {
      "key": "warehouseId",
      "value": "93000000-0000-0000-0000-000000000001"
    },
    {
      "key": "batchProductId",
      "value": ""
    },
    {
      "key": "createdBatchId",
      "value": ""
    },
    {
      "key": "missingProductId",
      "value": "99999999-9999-4999-8999-999999999991"
    },
    {
      "key": "missingBatchId",
      "value": "99999999-9999-4999-8999-999999999992"
    }
