              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop Dell XPS 15\",\n  \"category_id\": \"92000000-0000-0000-0000-000000000001\",\n  \"uom_id\": \"91000000-0000-0000-0000-000000000001\",\n  \"selling_price\": 25000000.00\n}"
