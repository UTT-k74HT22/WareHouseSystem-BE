{
  "info": {
    "name": "Location Management API",
    "description": "Complete API collection for Location Management feature",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "warehouseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "locationId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Create Location",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"{{warehouseId}}\",\n  \"code\": \"A01-R01-B01\",\n  \"name\": \"Aisle A - Rack 01 - Bin 01\",\n  \"zone\": \"Zone A\",\n  \"type\": \"STORAGE\",\n  \"capacity\": 1000.50,\n  \"notes\": \"Refrigerated storage location\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations"]
        }
      },
      "response": []
    },
    {
      "name": "2. Get All Locations (Paginated)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations?page=0&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations"],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. Get Location by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}"]
        }
      },
      "response": []
    },
    {
      "name": "4. Get Locations by Warehouse",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/warehouse/{{warehouseId}}?page=0&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "warehouse", "{{warehouseId}}"],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "5. Search Locations - All Filters",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/search?warehouse_id={{warehouseId}}&code=A01&name=Aisle&zone=Zone A&type=STORAGE&status=ACTIVE&page=0&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "search"],
          "query": [
            {
              "key": "warehouse_id",
              "value": "{{warehouseId}}"
            },
            {
              "key": "code",
              "value": "A01",
              "description": "Partial match"
            },
            {
              "key": "name",
              "value": "Aisle",
              "description": "Partial match"
            },
            {
              "key": "zone",
              "value": "Zone A",
              "description": "Partial match"
            },
            {
              "key": "type",
              "value": "STORAGE",
              "description": "Exact match - STORAGE|PICKING|PACKING|STAGING|RETURN"
            },
            {
              "key": "status",
              "value": "ACTIVE",
              "description": "Exact match - ACTIVE|INACTIVE|FULL|MAINTENANCE"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "6. Search Locations - By Zone Only",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/search?zone=Freezer&page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "search"],
          "query": [
            {
              "key": "zone",
              "value": "Freezer"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "7. Update Location",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated Location Name\",\n  \"zone\": \"Zone B\",\n  \"type\": \"PICKING\",\n  \"capacity\": 1500.00,\n  \"notes\": \"Updated notes - now used for picking operations\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}"]
        }
      },
      "response": []
    },
    {
      "name": "8. Update Location - Partial",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"capacity\": 2000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}"]
        }
      },
      "response": []
    },
    {
      "name": "9. Change Status to MAINTENANCE",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"MAINTENANCE\",\n  \"reason\": \"Scheduled maintenance - cleaning and repairs\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}", "status"]
        }
      },
      "response": []
    },
    {
      "name": "10. Change Status to FULL",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"FULL\",\n  \"reason\": \"Location reached maximum capacity\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}", "status"]
        }
      },
      "response": []
    },
    {
      "name": "11. Change Status to ACTIVE",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\",\n  \"reason\": \"Maintenance completed, location back to active\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}", "status"]
        }
      },
      "response": []
    },
    {
      "name": "12. Delete Location (Soft Delete)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}"]
        }
      },
      "response": []
    },
    {
      "name": "ERROR CASE: Create with Duplicate Code",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"{{warehouseId}}\",\n  \"code\": \"A01-R01-B01\",\n  \"name\": \"Duplicate Code Test\",\n  \"type\": \"STORAGE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations"]
        }
      },
      "response": []
    },
    {
      "name": "ERROR CASE: Create with Invalid Warehouse",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"non-existent-warehouse-id\",\n  \"code\": \"TEST-01\",\n  \"name\": \"Test Location\",\n  \"type\": \"STORAGE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations"]
        }
      },
      "response": []
    },
    {
      "name": "ERROR CASE: Create with Invalid Code Format",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"warehouse_id\": \"{{warehouseId}}\",\n  \"code\": \"Invalid Code With Spaces!\",\n  \"name\": \"Test Location\",\n  \"type\": \"STORAGE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations"]
        }
      },
      "response": []
    },
    {
      "name": "ERROR CASE: Get Non-existent Location",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/non-existent-id",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "non-existent-id"]
        }
      },
      "response": []
    },
    {
      "name": "ERROR CASE: Change to Same Status",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"ACTIVE\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/locations/{{locationId}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "locations", "{{locationId}}", "status"]
        }
      },
      "response": []
    }
  ]
}
